PUBLIC_URL=https://resolver.vpn4u.cc
CINEPRO_PUBLIC_URL=https://resolver.vpn4u.cc/cinepro
TRAEFIK_HOST=resolver.vpn4u.cc
TRAEFIK_NETWORK=media_net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
COMPOSE_PROJECT_NAME=justone

TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

WEBSTREAMR_MBG_URL=http://webstreamr-mbg:51546
SOURCE_PROVIDER_TIMEOUT_MS=5000
SOURCE_RESOLVE_TIMEOUT_MS=15000
SOURCE_PROBE_TIMEOUT_MS=2500

AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_INTERVAL_HOURS=24
AUTO_UPDATE_STARTUP_DELAY_MS=15000
AUTO_UPDATE_GIT_TIMEOUT_MS=30000
AUTO_UPDATE_BUILD_TIMEOUT_MS=1200000
AUTO_UPDATE_UP_TIMEOUT_MS=120000
AUTO_UPDATE_PROJECT_DIR=/workspace
AUTO_UPDATE_COMPOSE_FILE=/workspace/docker-compose.yml
AUTO_UPDATE_COMPOSE_ENV_FILE=/workspace/.env
AUTO_UPDATE_COMPOSE_PROJECT=justone
AUTO_UPDATE_STATE_DIR=/var/lib/justone-updater
CINEPRO_SOURCE_DIR=/workspace/providers/cinepro
WEBSTREAMR_MBG_SOURCE_DIR=/workspace/providers/webstreamr-mbg
CINEPRO_COMPOSE_SERVICE=cinepro
WEBSTREAMR_MBG_COMPOSE_SERVICE=webstreamr-mbg

DLHD_BASE=https://dlhd.st
DLSTREAMS_247=https://dlstreams.st/24-7-channels.php
DLSTREAMS_HOME=https://dlstreams.st/
EPG_URL=
JELLYFIN_EPG_SOURCE_URLS=
JELLYFIN_AUTO_EPG=true
JELLYFIN_EPG_MAX_SOURCES=12
JELLYFIN_EPG_CACHE_MIN=60
JELLYFIN_REFRESH_MIN=10
JELLYFIN_EXCLUDE_ADULT=true
LIVE_REFRESH_MIN=360
CATALOG_REFRESH_HOURS=6
QUALITIES=1080p,4k
RESOLVE_TTL_MS=3600000

# STRM libraries live here. Live TV/runtime files stay under RESOLVER_FILES.
LIBRARY_RESOLVER_ROOT=/mnt/library-resolver
RESOLVER_FILES=/mnt/resolver-files
PATH_MOVIES_1080=/mnt/library-resolver/Movies/Movies
PATH_MOVIES_4K=/mnt/library-resolver/Movies/Movies-4K
PATH_TV_1080=/mnt/library-resolver/TV/TV
PATH_TV_4K=/mnt/library-resolver/TV/TV-4K
PATH_LIVE=/mnt/resolver-files/Live

GENERATE_ON_START=true
MOVIE_PAGES=40
TV_PAGES=25
TV_MAX_EPISODES=24
TV_MAX_SEASONS=4
MAX_MOVIES=5000
MAX_SHOWS=1500
STRM_IO_DELAY_MS=20
QUALITY_FALLBACK=true
DISCOVER_FROM_YEAR=1980

ADMIN_PASSWORD=change-me
PLAYLIST_KEY=change-this-long-random-string-now