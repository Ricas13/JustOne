PUBLIC_URL=http://localhost:8090
PLAYLIST_KEY=

DLHD_BASE_URL=https://daddylivestream.com
DLHD_PROXY_PORT=3000
SOCKS5=
CHANNEL_REFRESH_SECONDS=300

JELLYFIN_LIVE_PORT=8090
JELLYFIN_REFRESH_MIN=10
JELLYFIN_EPG_CACHE_MIN=60
JELLYFIN_EPG_MAX_SOURCES=12
JELLYFIN_AUTO_EPG=true
JELLYFIN_EXCLUDE_ADULT=true
JELLYFIN_EPG_SOURCE_URLS=
DLSTREAMS_HOME=https://dlstreams.st/

# Playback is deliberately simple: candidate 1/source 1, then source 2,
# then the next merged candidate. No scoring, warm standby or learning.
JELLYFIN_SOURCES_PER_CANDIDATE=2
JELLYFIN_STREAM_STALL_MS=12000
