# Admin/API listener. docker-compose keeps direct host access on loopback and
# publishes the same listener through Traefik at https://resolver.vpn4u.cc.
PORT=8090
BIND_ADDRESS=0.0.0.0
DATA_DIR=/data
ADMIN_KEY=change-this-to-a-long-random-secret
JUSTONE_ADMIN_HOST=resolver.vpn4u.cc

# M3U/XMLTV listener. docker-compose exposes this only on media_net;
# there is deliberately no host port or Traefik router for 8091.
INTERNAL_PORT=8091
INTERNAL_BIND_ADDRESS=0.0.0.0
# Leave blank to derive http://justone-catalog:<INTERNAL_PORT>.
# Set only when Jellyfin/legacy consumers need a different internal hostname/base URL.
INTERNAL_BASE_URL=
INTERNAL_KEY=

# Native JustOne playback proxy. Jellyfin should ultimately consume the master
# M3U directly from JustOne; Dispatcharr is not required for playback.
# Use a separate proxy key so enabling/testing JustOne does not invalidate any
# existing legacy Dispatcharr URLs protected (or unprotected) by INTERNAL_KEY.
# If STREAM_PROXY_KEY is empty, INTERNAL_KEY is accepted as a compatibility fallback.
STREAM_PROXY_KEY=
# Rollout: enable the proxy first, test /m3u/proxy.m3u, then enable master mode.
STREAM_PROXY_ENABLED=false
STREAM_PROXY_MASTER_ENABLED=false
STREAM_STARTUP_TIMEOUT_MS=8000
STREAM_STARTUP_QUEUE_TIMEOUT_MS=1500
STREAM_STALL_TIMEOUT_MS=15000
STREAM_RELAY_GRACE_MS=8000
STREAM_FAILOVER_WINDOW_MS=12000
STREAM_FAILURE_COOLDOWN_MS=10000
STREAM_NOT_FOUND_COOLDOWN_MS=300000
STREAM_SOURCE_FAILURE_COOLDOWN_MS=60000
STREAM_MAX_CLIENT_BUFFER_BYTES=8388608
STREAM_STARTUP_BUFFER_BYTES=262144
STREAM_REPLAY_BUFFER_BYTES=1048576
STREAM_FAILOVER_KEEPALIVE_MS=500
STREAM_USER_AGENT=VLC/3.0.20 LibVLC/3.0.20

# Huge provider playlists are downloaded once a day and cached on disk.
# DLHD refreshes every 8 hours and rematches against those cached M3Us without
# downloading the provider files again.
PROVIDER_REFRESH_MINUTES=1440
DLHD_REFRESH_MINUTES=480
PROVIDER_CACHE_MAX_AGE_MINUTES=1440

FETCH_TIMEOUT_MS=30000
# Provider M3Us may be hundreds of MB. They are streamed rather than buffered.
PLAYLIST_FETCH_TIMEOUT_MS=1800000
PLAYLIST_MAX_LINE_LENGTH=4194304
DEFAULT_QUALITY_ORDER=HD,FHD,UHD,SD,UNKNOWN

# DLHD is the authoritative availability catalogue, not a playback source.
DLHD_FILTER_ENABLED=true
DLHD_BASE_URL=https://dlive.sx
# Optional. Without a key JustOne scrapes the public 24/7 + schedule pages.
DLHD_API_KEY=
DLHD_INCLUDE_247=true
DLHD_INCLUDE_SCHEDULE=true
DLHD_INCLUDE_UPCOMING=true
# Static/24-7 channels default to every country present in DLHD. Set a comma-separated
# ISO country list only if you intentionally want to narrow the global catalogue.
DLHD_STATIC_COUNTRIES=ALL
# Never fall back to publishing the whole IPTV provider list when DLHD is unavailable.
DLHD_FAIL_CLOSED=true

# Optional legacy Dispatcharr rollback/reconciliation. Not required for Jellyfin playback.
DISPATCHARR_URL=http://dispatcharr:9191
DISPATCHARR_API_KEY=
DISPATCHARR_USERNAME=
DISPATCHARR_PASSWORD=
DISPATCHARR_APPLY_ENABLED=false
DISPATCHARR_SYNC_LOGOS=true
