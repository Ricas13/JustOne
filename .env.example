# === JustOne Platform ===
PLATFORM_PORT=8080
PUBLIC_URL=http://localhost:8080

# === CinePro Core (VOD) ===
CINEPRO_URL=http://cinepro:3000
TMDB_API_KEY=your_tmdb_api_key_here
# Optional: enable CinePro's native Stremio endpoint as well
STREMIO_ADDON=true

# === dlhd-web (Live TV) ===
DLHD_URL=http://dlhd:3000
# Upstream mirror (DaddyLive / DLHD / DLStreams-style domain)
DLHD_BASE=https://dlhd.st

# === STRM / Jellyfin library paths (inside platform container) ===
LIBRARY_ROOT=/data/library
MOVIES_PATH=/data/library/movies
TV_PATH=/data/library/tv
LIVE_PATH=/data/library/live

# Prefer proxying streams through JustOne (recommended)
STRM_USE_PROXY=true

# === Optional ===
LOG_LEVEL=info
