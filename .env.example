PUBLIC_URL=http://localhost:8090
PLAYLIST_KEY=

DLHD_BASE_URL=https://dlive.sx
DLHD_PROXY_PORT=3000
SOCKS5=
CHANNEL_REFRESH_SECONDS=300

# Resolver retries for short provider-side 5xx bursts.
DLHD_SOURCE_RETRY_ATTEMPTS=3
DLHD_SOURCE_RETRY_BASE_SECONDS=1

# Real HLS resilience. Playback starts slightly behind live and the proxy keeps
# a bounded shared cache of upcoming media segments.
HLS_LIVE_START_OFFSET_SECONDS=12
HLS_PREFETCH_SEGMENTS=3
HLS_SEGMENT_CACHE_ITEMS=96
HLS_SEGMENT_CACHE_MAX_MB=128
HLS_SEGMENT_CACHE_TTL_SECONDS=120
HLS_PLAYLIST_INACTIVITY_SECONDS=90
HLS_UPSTREAM_TIMEOUT_SECONDS=5
HLS_SEGMENT_RETRY_ATTEMPTS=2
HLS_PLAYLIST_RETRY_ATTEMPTS=2
HLS_RETRY_BASE_SECONDS=0.5

JELLYFIN_LIVE_PORT=8090
JELLYFIN_REFRESH_MIN=10
JELLYFIN_EPG_CACHE_MIN=60
JELLYFIN_EPG_MAX_SOURCES=12
JELLYFIN_AUTO_EPG=true
JELLYFIN_EXCLUDE_ADULT=true
JELLYFIN_EPG_SOURCE_URLS=
DLSTREAMS_HOME=https://dlstreams.st/

# Playback exhausts ordered provider sources, but transient failures refresh the
# same source first. The old artificial FFmpeg output delay is disabled because
# the HLS proxy now keeps a real segment reserve.
JELLYFIN_SOURCES_PER_CANDIDATE=6
JELLYFIN_STREAM_STALL_MS=0
JELLYFIN_PREBUFFER_MS=0
JELLYFIN_FFMPEG_RW_TIMEOUT_MS=20000
JELLYFIN_SOURCE_REFRESH_RETRIES=2
JELLYFIN_SOURCE_REFRESH_BASE_MS=1000
