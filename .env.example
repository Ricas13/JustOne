PUBLIC_URL=http://localhost:8090
PLAYLIST_KEY=

DLHD_BASE_URL=https://daddylivestream.com
DLHD_PROXY_PORT=3000
SOCKS5=
CHANNEL_REFRESH_SECONDS=300

JELLYFIN_LIVE_PORT=8090
JELLYFIN_REFRESH_MIN=10
JELLYFIN_EPG_CACHE_MIN=60
JELLYFIN_EPG_MAX_SOURCES=12
JELLYFIN_AUTO_EPG=true
JELLYFIN_EXCLUDE_ADULT=true
JELLYFIN_EPG_SOURCE_URLS=
DLSTREAMS_HOME=https://dlstreams.st/

# Playback is deliberately simple: candidate 1/source 1, then source 2,
# then the next merged candidate. No scoring, warm standby or learning is
# applied to DLHD candidates.
JELLYFIN_SOURCES_PER_CANDIDATE=2
JELLYFIN_STREAM_STALL_MS=12000

# Optional verified AceStream source layer. DLHD remains the canonical channel
# catalogue. Newly discovered AceStream hashes are quarantined until verified.
ACESTREAM_ENABLED=false
ACESTREAM_SEARCH_URL=http://acestream:6878/search
ACESTREAM_MEDIAFLOW_URL=http://mediaflow-proxy:8888
ACESTREAM_MEDIAFLOW_API_KEY=
ACESTREAM_STATE_FILE=/app/data/acestream-state.json
ACESTREAM_DISCOVERY_BATCH=75
ACESTREAM_PAGE_SIZE=50
ACESTREAM_MAX_CANDIDATES=5
ACESTREAM_MIN_AVAILABILITY=0.5
# Keep false when public AceStream labels cannot be trusted. Manual verification
# can bootstrap a trusted Ace channel_id for automatic replacement-hash mapping.
ACESTREAM_AUTO_VERIFY_METADATA=false
# first = verified AceStream before DLHD; fallback = existing DLHD before AceStream
ACESTREAM_PRIORITY=first
