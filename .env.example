PUBLIC_URL=https://resolver.vpn4u.cc
CINEPRO_PUBLIC_URL=https://resolver.vpn4u.cc/cinepro
TRAEFIK_HOST=resolver.vpn4u.cc
TRAEFIK_NETWORK=media_net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
COMPOSE_PROJECT_NAME=justone

TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

WEBSTREAMR_MBG_URL=http://webstreamr-mbg:51546
SOURCE_PROVIDER_TIMEOUT_MS=5000
SOURCE_RESOLVE_TIMEOUT_MS=15000
SOURCE_PROBE_TIMEOUT_MS=2500
# Movie/episode playback hands safe header-free sources to the Jellyfin client.
# Header-dependent/internal-only sources keep using the existing proxy fallback.
DIRECT_MEDIA_HANDOFF=true
DIRECT_MEDIA_HANDOFF_TIMEOUT_MS=30000
# Playback performs a one-byte GET before delivery so HEAD-only false positives
# (expired links, Google Drive quota errors, etc.) are rejected. Failed source
# URLs are temporarily suppressed for interactive playback only and the resolver
# tries another source at the same requested quality.
PLAYBACK_SOURCE_PROBE_TIMEOUT_MS=5000
PLAYBACK_SOURCE_FAILURE_COOLDOWN_MS=300000
PLAYBACK_SOURCE_FAILOVER_ATTEMPTS=4
PLAYBACK_SOURCE_RECHECK_MS=15000
# Background catalog/4K traffic is globally paced so it cannot burst into the
# stream provider. Interactive playback gets a short priority window, and a
# 429 Retry-After response creates a shared cooldown.
WEBSTREAMR_BACKGROUND_MIN_INTERVAL_MS=1500
WEBSTREAMR_INTERACTIVE_GRACE_MS=2500
WEBSTREAMR_RATE_LIMIT_FALLBACK_MS=60000

AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_INTERVAL_HOURS=24
AUTO_UPDATE_STARTUP_DELAY_MS=15000
AUTO_UPDATE_GIT_TIMEOUT_MS=30000
AUTO_UPDATE_BUILD_TIMEOUT_MS=1200000
AUTO_UPDATE_UP_TIMEOUT_MS=120000
AUTO_UPDATE_PROJECT_DIR=/workspace
AUTO_UPDATE_COMPOSE_FILE=/workspace/docker-compose.yml
AUTO_UPDATE_COMPOSE_ENV_FILE=/workspace/.env
AUTO_UPDATE_COMPOSE_PROJECT=justone
AUTO_UPDATE_STATE_DIR=/var/lib/justone-updater
CINEPRO_SOURCE_DIR=/workspace/providers/cinepro
WEBSTREAMR_MBG_SOURCE_DIR=/workspace/providers/webstreamr-mbg
CINEPRO_COMPOSE_SERVICE=cinepro
WEBSTREAMR_MBG_COMPOSE_SERVICE=webstreamr-mbg

DLHD_BASE=https://dlhd.st
DLSTREAMS_247=https://dlstreams.st/24-7-channels.php
DLSTREAMS_HOME=https://dlstreams.st/
EPG_URL=
JELLYFIN_EPG_SOURCE_URLS=
JELLYFIN_AUTO_EPG=true
JELLYFIN_EPG_MAX_SOURCES=12
JELLYFIN_EPG_CACHE_MIN=60
JELLYFIN_REFRESH_MIN=10
JELLYFIN_EXCLUDE_ADULT=true
LIVE_REFRESH_MIN=360

# Incremental VOD catalog. MAX_* = 0 means no artificial ceiling.
CATALOG_REFRESH_HOURS=24
INITIAL_MOVIES_TARGET=10000
INITIAL_SHOWS_TARGET=1500
MOVIES_ADD_PER_RUN=2000
SHOWS_ADD_PER_RUN=100
MAX_MOVIES=0
MAX_SHOWS=0
DISCOVER_FROM_YEAR=1900
CATALOG_FRESH_PAGES=3
CATALOG_MAX_DISCOVERY_PAGES_PER_RUN=650
CATALOG_TMDB_DELAY_MS=200

# Conservative title availability sweep. Missing titles are quarantined, not deleted.
CATALOG_STATE_DIR=/mnt/resolver-files/catalog-state
CATALOG_QUARANTINE_ROOT=/mnt/library-resolver/.quarantine
CATALOG_HEALTH_ENABLED=true
CATALOG_HEALTH_INTERVAL_HOURS=24
CATALOG_HEALTH_MOVIES_PER_RUN=2500
CATALOG_HEALTH_SHOWS_PER_RUN=150
CATALOG_HEALTH_RETRY_FAILURES_PER_RUN=250
CATALOG_HEALTH_QUARANTINED_PER_RUN=50
CATALOG_HEALTH_CONCURRENCY=4
CATALOG_HEALTH_FAILURE_THRESHOLD=3
CATALOG_HEALTH_FAILURE_GAP_HOURS=24
CATALOG_HEALTH_QUARANTINE_DAYS=7
CATALOG_QUARANTINE_RECHECK_DAYS=7
CATALOG_HEALTH_STRICT=false
CATALOG_HEALTH_SHOW_SAMPLES=3

# 4K is source-qualified rather than blindly mirroring the normal library.
# The crawler writes normal STRMs; the audit promotes only positively identified
# 2160p/4K/UHD titles into the 4K roots and quarantines false 4K copies.
QUALITY_AUDIT_MOVIES_PER_RUN=2000
QUALITY_AUDIT_SHOWS_PER_RUN=150
QUALITY_AUDIT_SHOW_SAMPLES=3
QUALITY_AUDIT_CONCURRENCY=4
QUALITY_QUARANTINE_ROOT=/mnt/library-resolver/.quarantine/quality
QUALITY_4K_FALLBACK=false

# Broad catalog generation stays normal-resolution. 4K libraries are maintained
# by the quality auditor above.
QUALITIES=1080p
RESOLVE_TTL_MS=3600000

# STRM libraries live here. Live TV/runtime files stay under RESOLVER_FILES.
LIBRARY_RESOLVER_ROOT=/mnt/library-resolver
RESOLVER_FILES=/mnt/resolver-files
PATH_MOVIES_1080=/mnt/library-resolver/Movies/Movies
PATH_MOVIES_4K=/mnt/library-resolver/Movies/Movies-4K
PATH_TV_1080=/mnt/library-resolver/TV/TV
PATH_TV_4K=/mnt/library-resolver/TV/TV-4K
PATH_LIVE=/mnt/resolver-files/Live

GENERATE_ON_START=true
# Retained for dashboard/backward compatibility; incremental growth uses the
# CATALOG_* / *_ADD_PER_RUN settings above.
MOVIE_PAGES=40
TV_PAGES=25
TV_MAX_EPISODES=24
TV_MAX_SEASONS=4
STRM_IO_DELAY_MS=20
QUALITY_FALLBACK=true

ADMIN_PASSWORD=change-me
PLAYLIST_KEY=change-this-long-random-string-now
