# Public host (Traefik + Let's Encrypt)
PUBLIC_URL=https://resolver.vpn4u.cc
CINEPRO_PUBLIC_URL=https://resolver.vpn4u.cc/cinepro
TRAEFIK_HOST=resolver.vpn4u.cc
TRAEFIK_NETWORK=media_net
TRAEFIK_ENTRYPOINT=websecure
# Must match certificatesResolvers.<name> in your Traefik static config
TRAEFIK_CERTRESOLVER=le

TMDB_API_KEY=your_tmdb_api_key_here
STREMIO_ADDON=true

DLHD_BASE=https://dlhd.st
EPG_URL=
LIVE_REFRESH_MIN=30
QUALITIES=1080p,4k
RESOLVE_TTL_MS=900000

# Host path Jellyfin should also mount (same files)
# LIBRARY_BIND=/mnt/media/justone

LOG_LEVEL=info
