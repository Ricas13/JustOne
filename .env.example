# Public URL of the hub (used in STRM files, M3U, and Stremio stream URLs)
PUBLIC_URL=http://localhost:8080
CINEPRO_PUBLIC_URL=http://localhost:3000

# Optional Traefik (leave as localhost for local Docker)
TRAEFIK_HOST=localhost
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# CinePro Core (VOD) — required for movie/series resolve
TMDB_API_KEY=your_tmdb_api_key_here
STREMIO_ADDON=true

# Live TV resolver base domain (change when the site moves)
DLHD_BASE=https://dlhd.st

# STRM files should point at the JustOne proxy
STRM_USE_PROXY=true
LOG_LEVEL=info
