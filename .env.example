# Admin/API listener. docker-compose publishes it on host loopback only.
PORT=8090
BIND_ADDRESS=0.0.0.0
DATA_DIR=/data
ADMIN_KEY=change-me

# M3U/XMLTV listener. docker-compose exposes this only to the Docker network;
# there is deliberately no host port mapping for 8091.
INTERNAL_PORT=8091
INTERNAL_BIND_ADDRESS=0.0.0.0
INTERNAL_BASE_URL=http://justone-catalog:8091
INTERNAL_KEY=

REFRESH_MINUTES=30
FETCH_TIMEOUT_MS=30000
DEFAULT_QUALITY_ORDER=HD,FHD,UHD,SD,UNKNOWN

# DLHD is the authoritative availability catalogue, not a playback source.
DLHD_FILTER_ENABLED=true
DLHD_BASE_URL=https://dlive.sx
# Optional. Without a key JustOne scrapes the public 24/7 + schedule pages.
DLHD_API_KEY=
DLHD_INCLUDE_247=true
DLHD_INCLUDE_SCHEDULE=true
DLHD_INCLUDE_UPCOMING=true
# Never fall back to publishing the whole IPTV provider list when DLHD is unavailable.
DLHD_FAIL_CLOSED=true

# Dispatcharr reconciliation is metadata/control-plane only.
DISPATCHARR_URL=http://dispatcharr:9191
DISPATCHARR_API_KEY=
DISPATCHARR_USERNAME=
DISPATCHARR_PASSWORD=
DISPATCHARR_APPLY_ENABLED=false
DISPATCHARR_SYNC_LOGOS=true
