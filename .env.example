PUBLIC_URL=http://localhost:8090
PLAYLIST_KEY=

DLHD_BASE_URL=https://daddylivestream.com
DLHD_PROXY_PORT=3000
SOCKS5=
CHANNEL_REFRESH_SECONDS=300

JELLYFIN_LIVE_PORT=8090
JELLYFIN_REFRESH_MIN=10
JELLYFIN_EPG_CACHE_MIN=60
JELLYFIN_EPG_MAX_SOURCES=12
JELLYFIN_AUTO_EPG=true
JELLYFIN_EXCLUDE_ADULT=true
JELLYFIN_EPG_SOURCE_URLS=
DLSTREAMS_HOME=https://dlstreams.st/

# Playback exhausts all six ordered provider alternatives for a merged
# candidate before moving to the next candidate. No scoring, warm standby
# or learning is involved.
JELLYFIN_SOURCES_PER_CANDIDATE=6

# Hold a small amount of MPEG-TS before playback starts so brief upstream HLS
# gaps can be absorbed without a visible pause. Set to 0 to disable.
JELLYFIN_STREAM_PREBUFFER_MS=2500

# Log short recovered output gaps even though they are far below the hard
# failover stall threshold. This makes sub-second/one-second jitter visible.
JELLYFIN_STREAM_GAP_LOG_MS=1000
JELLYFIN_STREAM_STALL_MS=12000
