PUBLIC_URL=https://resolver.vpn4u.cc
TRAEFIK_HOST=resolver.vpn4u.cc
TRAEFIK_NETWORK=media_net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
COMPOSE_PROJECT_NAME=justone

# Live providers
DLHD_BASE=https://dlhd.st
DLHD_BASE_URL=https://dlstreams.st
DLSTREAMS_247=https://dlstreams.st/24-7-channels.php
DLSTREAMS_HOME=https://dlstreams.st/

# Live resolver health/caching. A cached channel is periodically revalidated all
# the way to readable HLS media before it is reused.
RESOLVE_TTL_MS=3600000
LIVE_SOURCE_PROBE_TIMEOUT_MS=7000
LIVE_SOURCE_RECHECK_MS=15000
LIVE_REFRESH_MIN=360

# Continuous RAM-only delay line for Jellyfin MPEG-TS playback. PCR timestamps
# keep the stream roughly this many seconds behind upstream so short provider/CDN
# stalls can consume queued media. Set to 0 for immediate delivery. The byte cap
# prevents runaway memory use per active stream.
LIVE_BUFFER_SECONDS=2
LIVE_BUFFER_MAX_BYTES=67108864

# Jellyfin Live TV / XMLTV
EPG_URL=
JELLYFIN_EPG_SOURCE_URLS=
JELLYFIN_AUTO_EPG=true
JELLYFIN_EPG_MAX_SOURCES=12
JELLYFIN_EPG_CACHE_MIN=60
JELLYFIN_REFRESH_MIN=10
JELLYFIN_EXCLUDE_ADULT=true

# Runtime files for generated M3U playlists and configured extra sources.
RESOLVER_FILES=/mnt/resolver-files
PATH_LIVE=/mnt/resolver-files/Live

ADMIN_PASSWORD=change-me
PLAYLIST_KEY=change-this-long-random-string-now
